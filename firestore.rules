rules_version = '2';

/**
 * CH Geladas PDV — Firestore Security Rules v4
 *
 * FIX [CRÍTICO]: Isolamento multiempresa em saas_dados.
 * Antes: allow read, write: if autenticado() — qualquer usuário autenticado
 * podia ler e escrever dados de QUALQUER empresa.
 * Agora: usuário só acessa saas_dados/{empresaId} se for membro dessa empresa
 * (verificado via saas_usuarios/{uid}.empresaId === empresaId).
 *
 * FIX [ALTO]: saas_empresas e saas_usuarios também tinham escrita aberta.
 * Agora: usuário só edita seu próprio documento; admin da empresa edita membros.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Funções auxiliares ──────────────────────────────────────────

    function autenticado() {
      return request.auth != null;
    }

    function docValido(data) {
      return data.keys().hasAll(['dados', 'ts'])
          && data.ts is string
          && data.ts.size() > 0;
    }

    function temAdminToken(data) {
      return data.keys().hasAny(['adminToken'])
          && data.adminToken is string
          && data.adminToken.size() >= 16;
    }

    function vendaValida(data) {
      return data.keys().hasAll(['id', 'total', 'itens', 'criadoEm'])
          && data.total is number
          && data.itens is list;
    }

    function movimentacaoValida(data) {
      return data.keys().hasAll(['produtoId', 'tipo', 'quantidade', 'timestamp'])
          && data.quantidade is number;
    }

    // FIX: verifica se o usuário pertence à empresa acessada
    function pertenceEmpresa(empresaId) {
      return autenticado()
          && exists(/databases/$(database)/documents/saas_usuarios/$(request.auth.uid))
          && get(/databases/$(database)/documents/saas_usuarios/$(request.auth.uid)).data.empresaId == empresaId;
    }

    // FIX: verifica se o usuário é admin da empresa
    function isAdminEmpresa(empresaId) {
      return pertenceEmpresa(empresaId)
          && get(/databases/$(database)/documents/saas_usuarios/$(request.auth.uid)).data.role in ['adm', 'admin', 'gerente'];
    }

    // ─── /ch_dados/comandas — qualquer autenticado pode escrever ────
    match /ch_dados/comandas {
      allow read:  if autenticado();
      allow write: if autenticado() && docValido(request.resource.data);
    }

    // ─── /ch_dados/fiado ────────────────────────────────────────────
    match /ch_dados/fiado {
      allow read:  if autenticado();
      allow write: if autenticado() && docValido(request.resource.data);
    }

    // ─── /ch_dados/cambio ───────────────────────────────────────────
    match /ch_dados/cambio {
      allow read:  if autenticado();
      allow write: if autenticado() && docValido(request.resource.data);
    }

    // ─── /ch_dados/perfis ───────────────────────────────────────────
    match /ch_dados/perfis {
      allow read:  if autenticado();
      allow write: if autenticado() && docValido(request.resource.data) && temAdminToken(request.resource.data);
    }

    // ─── /ch_dados/{colecao} ────────────────────────────────────────
    match /ch_dados/{colecao} {
      allow read:  if autenticado();
      allow write: if autenticado()
                   && docValido(request.resource.data)
                   && temAdminToken(request.resource.data);
    }

    // ─── /vendas/{vendaId} ──────────────────────────────────────────
    match /vendas/{vendaId} {
      allow create: if autenticado() && vendaValida(request.resource.data);
      allow read:   if autenticado();
      allow update: if autenticado();
      allow delete: if autenticado() && temAdminToken(request.resource.data);
    }

    // ─── /movimentacoes/{movId} ─────────────────────────────────────
    match /movimentacoes/{movId} {
      allow create: if autenticado() && movimentacaoValida(request.resource.data);
      allow read:   if autenticado();
      allow update, delete: if autenticado() && temAdminToken(request.resource.data);
    }

    // ─── /categorias/{catId} ────────────────────────────────────────
    match /categorias/{catId} {
      allow read:  if autenticado();
      allow write: if autenticado() && temAdminToken(request.resource.data);
    }

    // ─── /fornecedores/{fornId} ─────────────────────────────────────
    match /fornecedores/{fornId} {
      allow read:  if autenticado();
      allow write: if autenticado() && temAdminToken(request.resource.data);
    }

    // ─── /backups/{data}/snapshots/{snapshotId} ─────────────────────
    match /backups/{data}/snapshots/{snapshotId} {
      allow read:  if autenticado();
      allow write: if autenticado() && temAdminToken(request.resource.data);
    }

    // ─── SaaS: isolamento multiempresa ──────────────────────────────

    // FIX [CRÍTICO]: antes allow write: if autenticado() — sem isolamento.
    // Agora: empresa só lê/edita seus próprios dados.
    match /saas_empresas/{empresaId} {
      allow read:  if autenticado() && pertenceEmpresa(empresaId);
      allow write: if autenticado() && isAdminEmpresa(empresaId);
    }

    // FIX [ALTO]: usuário só edita seu próprio documento.
    match /saas_usuarios/{uid} {
      allow read:  if autenticado() && (request.auth.uid == uid || pertenceEmpresa(resource.data.empresaId));
      allow write: if autenticado() && request.auth.uid == uid;
    }

    match /saas_convites/{codigo} {
      allow read:  if autenticado();
      // FIX [MÉDIO]: convite só pode ser criado/deletado por admin da empresa dona do convite.
      // Antes qualquer autenticado podia criar convites para qualquer empresa.
      // O empresaId do convite é verificado via resource.data.empresaId.
      allow create: if autenticado()
                    && request.resource.data.keys().hasAll(['codigo','empresaId','criadoEm'])
                    && isAdminEmpresa(request.resource.data.empresaId);
      allow delete: if autenticado() && isAdminEmpresa(resource.data.empresaId);
      allow update: if false; // convites são imutáveis após criação
    }

    // FIX [CRÍTICO]: isolamento total de dados por empresa.
    // Antes: qualquer autenticado lia/escrevia dados de qualquer empresa.
    match /saas_dados/{empresaId}/{colecao}/{docId} {
      allow read, write: if pertenceEmpresa(empresaId);
    }

    // ─── /ch_tripwire — log imutável ────────────────────────────────
    match /ch_tripwire/{docId} {
      allow create: if autenticado();
      allow read:   if autenticado();
      allow update, delete: if false;
    }

    // ─── Bloqueia tudo não mapeado ───────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
